{
  "name": "urbanlink-flow",
  "version": "1.0.0",
  "description": "Plataforma completa de gestao e simulacao de logistica urbana",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
